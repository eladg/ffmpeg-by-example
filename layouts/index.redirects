# Netlify redirects, generated by Hugo from layouts/index.redirects.
# Edit that template, not public/_redirects.

# Gitalk 1.x rendered its comment-count link as href="null" when the GitHub API
# failed, which crawlers resolved to <example>/null
/examples/:id/:slug/null  /examples/:id/:slug/  301

# tags that were merged into another tag (Nov 2026 tag cleanup; see "Tag rules" in .claude/CLAUDE.md)
/tags/r128               /tags/ebu-r128/  301
/tags/normalize          /tags/ebu-r128/  301
/tags/loudness           /tags/ebu-r128/  301
/tags/normalization      /tags/ebu-r128/  301
/tags/video-generation   /tags/video-source/  301
/tags/audio-extraction   /tags/audio-extract/  301
/tags/testings           /tags/testsrc/  301
/tags/test-pattern       /tags/smpte-bars/  301
/tags/video-calibration  /tags/smpte-bars/  301
/tags/fps                /tags/frame-rate/  301
/tags/resize             /tags/scale/  301
/tags/image-scaling      /tags/scale/  301
/tags/alpha-channel      /tags/transparency/  301
/tags/ipod               /tags/itunes/  301
/tags/timestrech         /tags/rubberband/  301
/tags/speed              /tags/rubberband/  301
/tags/xfade              /tags/transitions/  301
/tags/combine            /tags/mux/  301
/tags/nb-read-frames     /tags/frame-count/  301
/tags/burn-in            /tags/hardsubs/  301
/tags/m3u8               /tags/hls/  301
/tags/video-extract      /tags/extract-frames/  301
/tags/frames             /tags/extract-frames/  301
/tags/stdin              /tags/pipe/  301
/tags/stdout             /tags/pipe/  301
/tags/image+audiovideo   /tags/image-to-video/  301
/tags/image+audio=video  /tags/image-to-video/  301
/tags/aspectratio        /tags/aspect-ratio/  301

# generic tags that were removed
/tags/cut                /tags/  301
/tags/filter             /tags/  301
/tags/video              /tags/  301
/tags/audio              /tags/  301
/tags/generator          /tags/  301
/tags/art                /tags/  301
/tags/camera             /tags/  301
/tags/broadcast          /tags/  301
/tags/compression        /tags/  301
/tags/web-graphics       /tags/  301
/tags/video-processing   /tags/  301
/tags/video-editing      /tags/  301

# the unused /edit section (and its placeholder page) was removed
/edit       /contribute/  301
/edit/keep  /contribute/  301

# paginated home pages used to link to "contribute" relatively (fixed in 5def65a)
/page/:n/contribute  /contribute/  301

# the home page used to be paginated (/page/2/ ...); it now lists every example.
# Must stay after the contribute rule above (Netlify uses the first match).
/page/*      /      301
/amp/page/*  /amp/  301

# list pages used to be paginated too; they now list every entry on one page
/examples/page/*           /examples/           301
/tags/page/*               /tags/               301
/tags/:tag/page/*          /tags/:tag/          301
/categories/page/*         /categories/         301
/categories/:cat/page/*    /categories/:cat/    301

# the About page was an empty placeholder and was removed
/about  /  301

# stable URL for the newest FFmpeg release in data/ffmpeg/changelog.json (302: it moves).
# Forced (!) so the alias page Hugo writes there (for hugo server) never shadows it.
/versions/latest  /versions/{{ hugo.Data.ffmpeg.changelog.latest }}/  302!

# "edit this example" links used to point to /edit/<ID>, which never existed
{{- range $page := where site.RegularPages "Section" "examples" }}
{{- with $page.Params.id }}
/edit/{{ . }}  {{ $page.RelPermalink }}  301
{{- if ne . (lower .) }}
/edit/{{ lower . }}  {{ $page.RelPermalink }}  301
{{- end }}
{{- end }}
{{- end }}
